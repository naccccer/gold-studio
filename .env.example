# Core app
DATABASE_URL="mysql://gold_studio_user:YOUR_DB_PASSWORD@127.0.0.1:3306/gold_studio?allowPublicKeyRetrieval=true"
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
ALLOW_INSECURE_COOKIES="false"
TRUST_PROXY="false"
SESSION_COOKIE_NAME="gold_session"
IMAGE_PROVIDER="liara"
GENERATION_WORKER_SECRET="REPLACE_WITH_A_LONG_RANDOM_WORKER_SECRET"
GENERATION_WORKER_URL="http://127.0.0.1:3000/api/internal/generation/worker"
GENERATION_WORKER_INTERVAL_MS="15000"
GENERATION_WORKER_LIMIT="1"
GENERATION_STALE_PROCESSING_MINUTES="90"
GALLERY_TEMP_UPLOAD_TTL_HOURS="24"
HEALTH_WATCHDOG_URL="http://127.0.0.1:3000/api/health"
HEALTH_WATCHDOG_PM2_APP="gold-studio"
HEALTH_WATCHDOG_INTERVAL_MS="30000"
HEALTH_WATCHDOG_TIMEOUT_MS="10000"
HEALTH_WATCHDOG_FAILURE_THRESHOLD="4"
HEALTH_WATCHDOG_RESTART_COOLDOWN_MS="120000"
BACKUP_RETENTION_COUNT="3"
BACKUP_TIMEZONE="Asia/Tehran"
BACKUP_SCHEDULE_HOUR="3"
BACKUP_SCHEDULE_MINUTE="0"
# Optional when executables are not on PATH:
# BACKUP_MYSQLDUMP_PATH="C:\\xampp\\mysql\\bin\\mysqldump.exe"
# BACKUP_TAR_PATH="C:\\Windows\\System32\\tar.exe"

# Liara image generation
LIARA_API_KEY="REPLACE_WITH_LIARA_API_KEY"
LIARA_VISION_API_KEY="REPLACE_WITH_LIARA_VISION_API_KEY"
LIARA_BASE_URL="https://ai.liara.ir/api/69fe30c50bb427e049d327f6/v1"
LIARA_IMAGE_MODEL="google/gemini-3-pro-image-preview"
LIARA_VISION_MODEL="google/gemini-2.0-flash-lite-001"
LIARA_IMAGE_SIZE="2048x2048"
LIARA_IMAGE_QUALITY="2K"
LIARA_FALLBACK_LONG_EDGE="2048"
LIARA_ALLOW_UPSCALE_FALLBACK="false"

# Avalai image generation testing
AVALAI_API_KEY="REPLACE_WITH_AVALAI_API_KEY"
AVALAI_BASE_URL="https://api.avalai.ir/v1"
AVALAI_USER_BASE_URL="https://api.avalai.ir/user/v1"
AVALAI_IMAGE_MODEL="gemini-3.1-flash-image"
AVALAI_VISION_MODEL="gemini-3.1-flash-lite"
AVALAI_IMAGE_SIZE="2K"
AVALAI_ASPECT_RATIO="1:1"
AVALAI_OPENAI_IMAGE_QUALITY="high"
AVALAI_RESPONSE_FORMAT="b64_json"

# FarazSMS phone verification
FARAZSMS_API_KEY="REPLACE_WITH_FARAZSMS_API_KEY"
FARAZSMS_PATTERN_CODE="REPLACE_WITH_FARAZSMS_PATTERN_CODE"
FARAZSMS_LINE_NUMBER="REPLACE_WITH_FARAZSMS_LINE_NUMBER"
FARAZSMS_OTP_VARIABLE_NAME="code"

# Storage
STORAGE_DRIVER="local"

# S3-compatible storage (only needed when STORAGE_DRIVER="s3")
S3_ENDPOINT="https://hot.ir-central1.arvanstorage.ir"
S3_REGION="ir-central1"
S3_BUCKET="gold-studio"
S3_ACCESS_KEY_ID="REPLACE_WITH_S3_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="REPLACE_WITH_S3_SECRET_KEY"
S3_PUBLIC_BASE_URL="https://gold-studio.hot.ir-central1.arvanstorage.ir"
S3_FORCE_PATH_STYLE="true"
