{
  "name": "gold-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:generate && next dev",
    "dev:food": "powershell -ExecutionPolicy Bypass -File scripts/dev-vertical.ps1 food",
    "dev:jewelry": "powershell -ExecutionPolicy Bypass -File scripts/dev-vertical.ps1 jewelry",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npm run db:generate",
    "db:generate": "node scripts/safe-prisma-generate.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:start": "powershell -ExecutionPolicy Bypass -File scripts/db-start.ps1",
    "db:stop": "powershell -ExecutionPolicy Bypass -File scripts/db-stop.ps1",
    "db:repair-access": "powershell -ExecutionPolicy Bypass -File scripts/db-repair-access.ps1",
    "db:export-local": "powershell -ExecutionPolicy Bypass -File scripts/export-local-db.ps1",
    "admin:bootstrap": "npm run db:generate && node scripts/bootstrap-admin.mjs",
    "worker:generation": "node scripts/generation-worker.mjs",
    "watchdog:health": "node scripts/health-watchdog.mjs",
    "check:liara": "node scripts/check-liara-direct.mjs",
    "check:avalai": "node scripts/check-avalai.mjs",
    "cleanup:archives": "node scripts/cleanup-archives.mjs",
    "backup:run": "node scripts/backup-run.mjs",
    "backup:scheduler": "node scripts/backup-scheduler.mjs",
    "thumbnails:prewarm": "node scripts/prewarm-image-thumbnails.mjs --concurrency=1",
    "check:image-delivery": "node scripts/check-image-delivery.mjs",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "check:model-routing": "node scripts/check-model-routing.mjs",
    "check:prompts": "node scripts/check-prompt-policy.mjs",
    "check:readiness": "node scripts/check-readiness.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "convert:placeholders": "node scripts/convert-placeholders-to-webp.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "mariadb": "^3.5.2",
    "next": "16.2.12",
    "node-addon-api": "^8.8.0",
    "openai": "^6.34.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.32.6",
    "tailwind-merge": "^3.6.0",
    "vuesax-icons-react": "^1.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "fast-xml-builder": "^1.3.0",
    "postcss": "^8.5.25",
    "sharp": "$sharp"
  }
}
