generator client {
  provider   = "prisma-client-js"
  engineType = "client"
  output     = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ProductAssetStatus {
  READY
  ARCHIVED
}

enum StyleReferenceAssetStatus {
  READY
  ARCHIVED
}

enum GenerationBatchStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum StyleControlType {
  CHOICE
  RANGE
  BOOLEAN
}

enum BillingPackageType {
  CREDIT_PACK
  SUBSCRIPTION
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
  EXPIRED
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum CreditEventSource {
  SIGNUP
  ADMIN
  PACKAGE
  SUBSCRIPTION
  GENERATION
  REFERRAL
  SALES_CODE
}

enum GenerationCreditReservationSource {
  CREDIT_BALANCE
  SUBSCRIPTION
}

enum GenerationCreditReservationStatus {
  RESERVED
  CAPTURED
  RELEASED
}

enum ProviderEventStatus {
  SUCCESS
  FAILED
}

enum SupportTicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum SupportMessageAuthor {
  USER
  ADMIN
}

model User {
  id                    String             @id @default(cuid())
  name                  String?
  email                 String?            @unique
  phone                 String?            @unique
  referralCode          String?            @unique
  passwordHash          String
  role                  UserRole           @default(USER)
  credits               Int                @default(1)
  reservedCredits       Int                @default(0)
  projects              Project[]
  assets                ProductAsset[]
  styleReferenceAssets  StyleReferenceAsset[]
  collections           AssetCollection[]
  batches               GenerationBatch[]
  subscriptions         UserSubscription[] @relation("UserSubscriptions")
  assignedSubscriptions UserSubscription[] @relation("AssignedSubscriptions")
  purchaseRequests      PurchaseRequest[]
  creditEvents          CreditEvent[]      @relation("UserCreditEvents")
  creditReservations    GenerationCreditReservation[]
  authoredCreditEvents  CreditEvent[]      @relation("AdminCreditEvents")
  invitedReferrals      Referral[]         @relation("InviterReferrals")
  acceptedReferral      Referral?          @relation("InviteeReferral")
  outputSettings        UserOutputSettings?
  supportTickets        SupportTicket[]    @relation("UserSupportTickets")
  supportMessages       SupportTicketMessage[] @relation("UserSupportMessages")
  adminSupportMessages  SupportTicketMessage[] @relation("AdminSupportMessages")
  auditEvents           AdminAuditEvent[]  @relation("AdminAuditActor")
  createdSalesReferralCodes SalesReferralCode[] @relation("SalesReferralCodeAdmin")
  redeemedSalesReferralCodes SalesReferralCode[] @relation("SalesReferralCodeRedeemer")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model Project {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAssetId    String?
  sourceAsset      ProductAsset?         @relation(fields: [sourceAssetId], references: [id], onDelete: SetNull)
  referenceAssetId String?
  referenceAsset   StyleReferenceAsset?  @relation(fields: [referenceAssetId], references: [id], onDelete: SetNull)
  title            String?
  sourceImageUrl   String
  resultImageUrl   String?
  resultStorageKey String?
  status           ProjectStatus         @default(QUEUED)
  outputPreset     String                @default("post")
  styleId          String
  style            CreativeStyle         @relation(fields: [styleId], references: [id], onDelete: Restrict)
  prompt           String                @db.Text
  errorMessage     String?
  archivedAt       DateTime?
  freeVariantUsedAt DateTime?
  freeVariantProjectId String?
  variantParentId String?
  batchItems       GenerationBatchItem[]
  providerEvents   ProviderEvent[]
  creditReservations GenerationCreditReservation[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([userId, createdAt])
  @@index([userId, archivedAt])
  @@index([sourceAssetId])
  @@index([referenceAssetId])
  @@index([styleId])
  @@index([freeVariantProjectId])
  @@index([variantParentId])
}

model StyleCategory {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  sortOrder Int             @default(0)
  styles    CreativeStyle[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model CreativeStyle {
  id              String            @id @default(cuid())
  categoryId      String?
  category        StyleCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name            String
  description     String
  prompt          String            @db.Text
  previewImageUrl String
  previewSource   String            @default("placeholder")
  sortOrder       Int               @default(0)
  isActive        Boolean           @default(true)
  isUserVisible   Boolean           @default(true)
  variants        StyleVariant[]
  controls        StyleControl[]
  projects        Project[]
  batches         GenerationBatch[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([categoryId])
  @@index([isActive, isUserVisible, sortOrder])
}

model StyleVariant {
  id              String        @id @default(cuid())
  styleId         String
  style           CreativeStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)
  name            String
  prompt          String        @db.Text
  previewImageUrl String?
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([styleId, sortOrder])
}

model StyleControl {
  id           String           @id @default(cuid())
  styleId      String
  style        CreativeStyle    @relation(fields: [styleId], references: [id], onDelete: Cascade)
  key          String
  label        String
  type         StyleControlType
  optionsJson  String?          @db.Text
  defaultValue String?
  minValue     Int?
  maxValue     Int?
  sortOrder    Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([styleId, key])
  @@index([styleId, sortOrder])
}

model AssetCollection {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  assets    ProductAsset[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, createdAt])
}

model ProductAsset {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   AssetCollection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  fileUrl      String
  storageKey   String
  mimeType     String
  originalName String?
  title        String?
  notes        String?
  productType  String?
  visionShortTitle String?
  visionDescription String?               @db.Text
  visionAngle  String?
  visionQualityIssues String?             @db.Text
  visionConfidence Float?
  visionModel  String?
  visionAnalyzedAt DateTime?
  visionError  String?                    @db.Text
  status       ProductAssetStatus    @default(READY)
  archivedAt   DateTime?
  projects     Project[]
  batchItems   GenerationBatchItem[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([userId, createdAt])
  @@index([userId, archivedAt])
  @@index([collectionId])
}

model StyleReferenceAsset {
  id           String                    @id @default(cuid())
  userId       String
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl      String
  storageKey   String
  mimeType     String
  originalName String?
  title        String?
  notes        String?
  status       StyleReferenceAssetStatus @default(READY)
  archivedAt   DateTime?
  projects     Project[]
  batches      GenerationBatch[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([userId, createdAt])
  @@index([userId, archivedAt])
}

model GenerationBatch {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String?
  styleId      String
  style        CreativeStyle         @relation(fields: [styleId], references: [id], onDelete: Restrict)
  referenceAssetId String?
  referenceAsset   StyleReferenceAsset?  @relation(fields: [referenceAssetId], references: [id], onDelete: SetNull)
  outputPreset String
  status       GenerationBatchStatus @default(QUEUED)
  items        GenerationBatchItem[]
  creditReservations GenerationCreditReservation[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([userId, createdAt])
  @@index([styleId])
  @@index([referenceAssetId])
}

model GenerationBatchItem {
  id        String          @id @default(cuid())
  batchId   String
  batch     GenerationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  assetId   String
  asset     ProductAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@index([batchId])
  @@index([assetId])
  @@index([projectId])
}

model BillingPackage {
  id               String             @id @default(cuid())
  type             BillingPackageType
  title            String
  description      String             @db.Text
  priceAmount      Int
  currency         String             @default("IRR")
  credits          Int                @default(0)
  periodDays       Int?
  colorPreset      String             @default("amber")
  isActive         Boolean            @default(true)
  isPublic         Boolean            @default(true)
  sortOrder        Int                @default(0)
  archivedAt       DateTime?
  subscriptions    UserSubscription[]
  purchaseRequests PurchaseRequest[]
  creditEvents     CreditEvent[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([type, isActive, isPublic, sortOrder])
  @@index([archivedAt])
}

model UserSubscription {
  id                    String             @id @default(cuid())
  userId                String
  user                  User               @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  packageId             String
  package               BillingPackage     @relation(fields: [packageId], references: [id], onDelete: Restrict)
  status                SubscriptionStatus @default(ACTIVE)
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  creditsPerPeriod      Int
  creditsUsedThisPeriod Int                @default(0)
  reservedCredits       Int                @default(0)
  assignedByAdminId     String?
  assignedByAdmin       User?              @relation("AssignedSubscriptions", fields: [assignedByAdminId], references: [id], onDelete: SetNull)
  purchaseRequestId     String?            @unique
  purchaseRequest       PurchaseRequest?   @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  notes                 String?            @db.Text
  creditEvents          CreditEvent[]
  creditReservations    GenerationCreditReservation[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([userId, status])
  @@index([packageId])
  @@index([assignedByAdminId])
  @@index([currentPeriodEnd])
}

model PurchaseRequest {
  id                 String                @id @default(cuid())
  userId             String
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId          String
  package            BillingPackage        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  status             PurchaseRequestStatus @default(PENDING)
  amount             Int
  currency           String                @default("IRR")
  receiptImageUrl    String?
  receiptStorageKey  String?
  receiptNote        String?               @db.Text
  receiptSubmittedAt DateTime?
  adminNote          String?               @db.Text
  subscription       UserSubscription?
  creditEvent        CreditEvent?
  referralReward     Referral?             @relation("ReferralRewardPurchase")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([userId, status])
  @@index([packageId])
  @@index([status, createdAt])
}

model PaymentSettings {
  id             String   @id @default("default")
  cardholderName String
  cardNumber     String
  instructions   String?  @db.Text
  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model CreditEvent {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation("UserCreditEvents", fields: [userId], references: [id], onDelete: Cascade)
  actorAdminId   String?
  actorAdmin     User?             @relation("AdminCreditEvents", fields: [actorAdminId], references: [id], onDelete: SetNull)
  delta          Int
  balanceBefore  Int
  balanceAfter   Int
  reason         String            @db.Text
  source         CreditEventSource
  packageId      String?
  package        BillingPackage?   @relation(fields: [packageId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  purchaseRequestId String?        @unique
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  referralId     String?
  referral       Referral?         @relation(fields: [referralId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([actorAdminId])
  @@index([packageId])
  @@index([subscriptionId])
  @@index([referralId])
  @@index([source])
}

model GenerationCreditReservation {
  id             String                            @id @default(cuid())
  userId         String
  user           User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?                          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  batchId        String?
  batch          GenerationBatch?                  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   UserSubscription?                 @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  source         GenerationCreditReservationSource
  status         GenerationCreditReservationStatus @default(RESERVED)
  capturedAt     DateTime?
  releasedAt     DateTime?
  createdAt      DateTime                          @default(now())
  updatedAt      DateTime                          @updatedAt

  @@index([userId, status, createdAt])
  @@index([projectId, status])
  @@index([batchId, status])
  @@index([subscriptionId, status])
}

model Referral {
  id            String        @id @default(cuid())
  inviterId     String
  inviter       User          @relation("InviterReferrals", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId     String        @unique
  invitee       User          @relation("InviteeReferral", fields: [inviteeId], references: [id], onDelete: Cascade)
  codeUsed      String
  rewardCredits Int           @default(5)
  rewardGrantedAt DateTime?
  rewardPurchaseRequestId String? @unique
  rewardPurchaseRequest PurchaseRequest? @relation("ReferralRewardPurchase", fields: [rewardPurchaseRequestId], references: [id], onDelete: SetNull)
  creditEvents  CreditEvent[]
  createdAt     DateTime      @default(now())

  @@index([inviterId, createdAt])
  @@index([codeUsed])
  @@index([rewardGrantedAt])
}

model SalesReferralCode {
  id               String   @id @default(cuid())
  code             String   @unique
  creditAmount     Int      @default(5)
  batchKey         String
  salespersonName  String?
  note             String?  @db.Text
  createdByAdminId String
  createdByAdmin   User     @relation("SalesReferralCodeAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  redeemedByUserId String?
  redeemedByUser   User?    @relation("SalesReferralCodeRedeemer", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  redeemedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([batchKey, createdAt])
  @@index([redeemedAt, createdAt])
  @@index([createdByAdminId, createdAt])
  @@index([redeemedByUserId])
}

model UserOutputSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultOutputPreset  String   @default("post")
  preferredQuality     String   @default("2K")
  fileNamingMode       String   @default("project-date")
  autoSaveToProjects   Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SupportSettings {
  id             String   @id @default("default")
  phone          String?
  whatsappUrl    String?
  telegramUrl    String?
  instructions   String?  @db.Text
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model SupportTicket {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation("UserSupportTickets", fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    SupportTicketStatus   @default(OPEN)
  messages  SupportTicketMessage[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model SupportTicketMessage {
  id          String               @id @default(cuid())
  ticketId    String
  ticket      SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType  SupportMessageAuthor
  userId      String?
  user        User?                @relation("UserSupportMessages", fields: [userId], references: [id], onDelete: SetNull)
  adminId     String?
  admin       User?                @relation("AdminSupportMessages", fields: [adminId], references: [id], onDelete: SetNull)
  body        String               @db.Text
  createdAt   DateTime             @default(now())

  @@index([ticketId, createdAt])
  @@index([userId])
  @@index([adminId])
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model AdminAuditEvent {
  id           String   @id @default(cuid())
  actorAdminId String?
  actorAdmin   User?    @relation("AdminAuditActor", fields: [actorAdminId], references: [id], onDelete: SetNull)
  action       String
  targetType   String
  targetId     String
  summary      String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorAdminId, createdAt])
  @@index([targetType, targetId])
  @@index([action])
}

model ProviderEvent {
  id           String              @id @default(cuid())
  projectId    String?
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  provider     String              @default("liara")
  operation    String
  status       ProviderEventStatus
  model        String?
  statusDetail String?             @db.Text
  errorMessage String?             @db.Text
  retryCount   Int                 @default(0)
  createdAt    DateTime            @default(now())

  @@index([projectId, createdAt])
  @@index([provider, status, createdAt])
}
